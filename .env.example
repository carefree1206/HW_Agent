# Documentation only. The app does not automatically load this file.
# Set these as process environment variables before starting the server.

# Optional SQLite location; relative paths are relative to the project cwd.
UNDELIVERED_DB=var/undelivered.db

# Must match the actual uvicorn port; start-demo.ps1 configures this for you.
UNDELIVERED_INTERNAL_URL=http://127.0.0.1:8000

# Optional comma-separated exact browser origins for a controlled demo.
# Origin validation is not authentication. Remote deployment is a future task.
UNDELIVERED_ALLOWED_ORIGINS=
